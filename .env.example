# Copy to .env and adjust. Never commit .env.
#
# Every value here is a local-development default. Nothing in this file is a
# real credential, and nothing in this repo reads a credential from anywhere
# except the environment.

# --- Postgres -------------------------------------------------------------
# `localhost` is right for anything you run on the host — pytest, `make
# rag-index`, psql. Services inside the compose network reach Postgres as
# `postgres` and get that from docker-compose.yml, not from here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_locally

MERIDIAN_APP_PASSWORD=change_me_locally
MERIDIAN_ETL_PASSWORD=change_me_locally
DBT_RUNNER_PASSWORD=change_me_locally
ANALYTICS_RO_PASSWORD=change_me_locally
AIRFLOW_DB_PASSWORD=change_me_locally
RAG_INDEXER_PASSWORD=change_me_locally

# --- MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LAKE_BUCKET=meridian-lake

# --- Redpanda -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- API ------------------------------------------------------------------
API_JWT_SECRET=generate_a_random_value_locally
API_JWT_EXPIRY_MINUTES=60
API_INGEST_KEY=generate_a_random_value_locally

# --- AI layer -------------------------------------------------------------
# Optional. Without it the platform still runs end to end: retrieval works and
# /v1/ai/ask returns a real extractive answer built from retrieved passages.
# With it, batch enrichment produces genuine intent/sentiment classifications.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- RAG retrieval --------------------------------------------------------
# Reciprocal Rank Fusion constant. 60 is the value from the original RRF paper
# and is deliberately not tuned per-corpus: RRF's whole appeal is that it needs
# no score calibration between the lexical and vector rankers.
RAG_RRF_K=60
# How deep each ranker goes before fusion. Larger costs nothing measurable here
# and lets a document ranked poorly by one ranker still be rescued by the other.
RAG_CANDIDATE_POOL=50
RAG_TOP_K=5
# Below this cosine similarity to the best-matching chunk, the generator
# abstains instead of answering. Calibrated against eval/golden_questions.yml —
# see `make rag-eval`, which prints the separation this threshold sits in.
RAG_ABSTAIN_SIMILARITY=0.68

# --- Airflow ---------------------------------------------------------------
AIRFLOW_FERNET_KEY=generate_with__python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_JWT_SECRET=generate_a_random_value_locally
AIRFLOW_PORT=8080
