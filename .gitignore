# Generated source data. The generator is deterministic — regenerate with
# `make seed` rather than committing 23MB of CSV.
seeds/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets — never committed. .env.example is the template.
.env
.env.local
*.pem

# Local service state
.duckdb/
minio-data/
postgres-data/
logs/

# dbt. `.dbt-venv` is a second interpreter, separate from .venv on purpose —
# CONTRACTS.md §6: Airflow pins protobuf 4.x, dbt-core requires 6.x, and keeping
# the split locally means `make dbt-run` exercises the production arrangement.
.dbt-venv/
target/
dbt_packages/
package-lock.yml
logs/
# dbt writes an anonymous-usage id here on first run. Machine-local, not project state.
.user.yml

# OS / editors
.DS_Store
.vscode/
.idea/

# Staged at build time by `make airflow-build`; environment-specific, never committed.
airflow/certs/*.crt
